# ── окружение и секреты ──────────────────────────────────────────
.env
.venv/
venv/
secrets/

# ── мусор сборки и инструментов ──────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.wrangler/
*.log

# ── настройки редакторов ─────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── не нужно для запуска бота ────────────────────────────────────
# исходники макета Claude Design: вёрстка уже перенесена в webapp/
project/
# переписка по ходу разработки
chats/
# черновики и личные заметки
tools/
# граф знаний по проекту (graphify) — пересобирается из исходников
graphify-out/
# расписания, скачанные для проверки парсера: берутся с сайта ВолгГТУ
*.xls
*.xlsx
# сжатые копии статики: создаются в образе при сборке
*.gz
