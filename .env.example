# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL (asyncpg). Пример для локальной установки на Windows:
DATABASE_URL=postgresql+asyncpg://schedule:schedule@localhost:5432/schedule

# Telegram id тех, кому разрешён /import (через запятую).
# Пусто = импорт разрешён всем (удобно на этапе настройки).
ADMIN_IDS=

# Границы семестра — по ним считаются конкретные даты занятий
SEMESTER_YEAR=2026
SEMESTER_START=2026-09-01
SEMESTER_END=2026-12-31
