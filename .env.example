# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL (asyncpg). Нужен только для запуска без Docker: в контейнере адрес
# базы задан в docker-compose.yml. Порт 5433 — так база из compose опубликована
# наружу (5432 обычно занят локальным PostgreSQL).
DATABASE_URL=postgresql+asyncpg://schedule:schedule@localhost:5433/schedule

# Границы семестра — по ним считаются конкретные даты занятий
SEMESTER_YEAR=2026
SEMESTER_START=2026-09-01
SEMESTER_END=2026-12-31

# Как часто сверять расписания с сайтом ВолгГТУ (часы); неизменившиеся файлы не качаются
SCHEDULE_REFRESH_HOURS=6

# --- Docker: туннель до публичного адреса ---
# Telegram открывает Mini App только по https, поэтому нужен публичный адрес.
# lhr — localhost.run: ни домена, ни аккаунта; адрес выдаётся при подключении
# и меняется при каждом переподключении, бот подхватывает его сам.
COMPOSE_PROFILES=lhr

# --- Mini App ---
# Постоянный публичный HTTPS-адрес приложения: свой сервер с HTTPS. Задан —
# используется именно он. Для localhost.run оставить пустым: адрес придёт от
# туннеля и меняется при каждом переподключении.
WEBAPP_URL=
# Файл, из которого читается адрес localhost.run. Внутри контейнера это общий
# том; на хосте файла нет. Читается только при пустом WEBAPP_URL.
WEBAPP_URL_FILE=/state/url
# На каком адресе слушать локально
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=7070
# 1 = разрешить открывать приложение в обычном браузере без подписи Telegram
# (только для отладки, на проде оставьте 0)
WEBAPP_ALLOW_INSECURE=0
