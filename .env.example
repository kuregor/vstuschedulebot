# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL (asyncpg). Нужен только для запуска без Docker: в контейнере адрес
# базы задан в docker-compose.yml. Порт 5433 — так база из compose опубликована
# наружу (5432 обычно занят локальным PostgreSQL).
DATABASE_URL=postgresql+asyncpg://schedule:schedule@localhost:5433/schedule

# Границы семестра — по ним считаются конкретные даты занятий
SEMESTER_YEAR=2026
SEMESTER_START=2026-09-01
SEMESTER_END=2026-12-31

# Как часто сверять расписания с сайтом ВолгГТУ (часы); неизменившиеся файлы не качаются
SCHEDULE_REFRESH_HOURS=6

# --- Docker: какой туннель поднимать (docker compose up -d --build) ---
# Telegram открывает Mini App только по https, поэтому нужен публичный адрес.
#   cf  — Cloudflare Tunnel, постоянный адрес на своём домене. Нужны
#         cloudflared/config.yml и ключ в secrets/cloudflared/ (см. README_BOT.md),
#         сам адрес — в WEBAPP_URL ниже
#   lhr — localhost.run, без домена и регистрации. Адрес выдаётся при
#         подключении и бот подхватывает его сам; WEBAPP_URL оставить пустым
# Часть домашних провайдеров блокирует Cloudflare Tunnel целиком (в логе
# cloudflared — «TLS handshake with edge error: EOF»): тогда только lhr.
COMPOSE_PROFILES=cf
# Провайдер режет DNS-записи Cloudflare (cloudflared в логах не находит edge)?
# Подключите DoH-резолвер (в Linux/macOS разделитель «:» вместо «;»):
#COMPOSE_FILE=docker-compose.yml;docker-compose.doh.yml

# --- Mini App ---
# Постоянный публичный HTTPS-адрес приложения: домен за Cloudflare Tunnel
# (профиль cf) или свой сервер с HTTPS. Задан — используется именно он.
# Для localhost.run (профиль lhr) оставить пустым: адрес придёт от туннеля.
WEBAPP_URL=https://app.kuregor.ru
# Файл, из которого читается адрес localhost.run. Внутри контейнера это общий
# том; на хосте файла нет. Читается только при пустом WEBAPP_URL.
WEBAPP_URL_FILE=/state/url
# На каком адресе слушать локально
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=7070
# 1 = разрешить открывать приложение в обычном браузере без подписи Telegram
# (только для отладки, на проде оставьте 0)
WEBAPP_ALLOW_INSECURE=0
