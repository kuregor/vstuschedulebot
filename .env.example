# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL (asyncpg). Пример для локальной установки на Windows:
DATABASE_URL=postgresql+asyncpg://schedule:schedule@localhost:5432/schedule

# Telegram id тех, кому разрешён /import (через запятую).
# Пусто = импорт разрешён всем (удобно на этапе настройки).
ADMIN_IDS=

# Границы семестра — по ним считаются конкретные даты занятий
SEMESTER_YEAR=2026
SEMESTER_START=2026-09-01
SEMESTER_END=2026-12-31

# --- Mini App (приложение внутри Telegram) ---
# Публичный HTTPS-адрес приложения. Telegram открывает Mini App только по https,
# поэтому локально нужен туннель (cloudflared / ngrok), см. README_BOT.md.
WEBAPP_URL=
# На каком адресе слушать локально
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# 1 = разрешить открывать приложение в обычном браузере без подписи Telegram
# (только для отладки, на проде оставьте 0)
WEBAPP_ALLOW_INSECURE=0
